+<title>Shares — Volume Gallery</title>
+<script src="/js/theme-init.js?v=hist1"></script>
+<link rel="stylesheet" href="/css/style.css?v=org2" />
+<style>
+  .stats { display: flex; flex-wrap: wrap; border: 1px solid var(--line); border-radius: var(--radius); margin: 1em 0; }
+  .stat { flex: 1 1 190px; padding: 0.7em 1em; border-right: 1px solid var(--line); min-width: 0; }
+  .stat:last-child { border-right: 0; }
+  .stat .n { font: 600 1.5em var(--mono); }
+  .stat .l { color: var(--text-dim); font-size: 0.8em; text-transform: uppercase; letter-spacing: 0.04em; }
+  .stat .d { color: var(--text-dim); font-size: 0.85em; margin-top: 0.2em; }
+  .tabs { display: flex; gap: 0.4em; margin: 0.4em 0 0.2em; }
+  .tabs button[aria-selected="true"] { border-color: var(--accent); color: var(--accent); }
+  .filters { display: flex; flex-wrap: wrap; gap: 0.5em; align-items: center; margin: 0.8em 0; }
+  .filters input[type="search"] { flex: 1 1 220px; min-width: 0; }
+  .sub { color: var(--text-dim); font-size: 0.85em; }
+  .warn { color: var(--danger); }
+  .okc { color: var(--ok); }
+  .bar { height: 8px; background: var(--panel-raised); border: 1px solid var(--line); border-radius: 2px; overflow: hidden; min-width: 60px; }
+  .bar > i { display: block; height: 100%; background: var(--accent); }
+  .bar.big { height: 14px; }
+  .spark { display: block; color: var(--accent); margin: 0.25em 0; }
+  .spark rect { fill: currentColor; }
+  td.num, th.num { text-align: right; font-family: var(--mono); white-space: nowrap; }
+  .related { margin-top: 0.25em; font-size: 0.85em; color: var(--text-dim); }
+  .clip { max-width: 22ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block; vertical-align: bottom; }
+  .kv { display: grid; grid-template-columns: max-content 1fr; gap: 0.2em 1em; margin: 0.6em 0 1em; }
+  .kv dt { color: var(--text-dim); }
+  .kv dd { margin: 0; font-family: var(--mono); }
