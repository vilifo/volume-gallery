events {
    worker_connections 1024;
}
 
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;

    open_file_cache          max=4096 inactive=60s;
    open_file_cache_valid    30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors   on;

    gzip              on;
    gzip_comp_level   4;
    gzip_min_length   1024;
    gzip_vary         on;
    gzip_types        application/json text/css text/javascript application/javascript image/svg+xml;
 
    # OME-Zarr/TIFF-stack archives can be large — don't cap upload size.
    client_max_body_size 0;

    # Anything nginx has to spool to disk goes into the processing directory (mounted
    # into this container at /processing, see docker-compose.yml), never into the
    # container's writable layer. That covers an upload body when request buffering is
    # on (see proxy_request_buffering below) and large proxied responses. nginx creates
    # these directories itself at startup, so the parent (/processing) must be writable.
    client_body_temp_path /tmp/.nginx_client_body 1 2;
    proxy_temp_path       /tmp/.nginx_proxy 1 2;

    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;
    client_body_timeout 1200s;

    upstream volume_gallery_backend {
        server volume-gallery:8000;
        keepalive 32;
    }
 
    # Plain HTTP just redirects to HTTPS. WebGPU (needed by the volume
    # viewer) refuses to run outside a secure context, so there's no
    # reason to ever serve the app itself over http://.
    #
    # IPv4 only by default — add "listen [::]:80;" / "listen [::]:443 ssl;"
    # below if your Docker host has IPv6 enabled and you need LAN IPv6
    # access; some Docker hosts (including some TrueNAS SCALE setups) don't
    # have it enabled, and nginx fails to start entirely if told to bind an
    # address family the host doesn't support

	# HTTP block
	server {
		listen 80;
		server_name _;
		return 301 https://$host:${VG_HTTPS_PORT}$request_uri;
	}

	# HTTPS block
	server {
		listen 443 ssl;
		http2 on;
		server_name _;

		ssl_certificate     /etc/nginx/certs/fullchain.pem;
		ssl_certificate_key /etc/nginx/certs/privkey.pem;
		ssl_protocols       TLSv1.2 TLSv1.3;
		ssl_ciphers         HIGH:!aNULL:!MD5;
		ssl_prefer_server_ciphers on;

		# Internal location used by serve_zarr_file's X-Accel-Redirect response.
		# Marked `internal;` so direct client requests to /_internal_volumes/... return 404.
		location /_internal_volumes/ {
			internal;
			gzip off;
			alias /data/volumes/;
			 add_header Cache-Control $upstream_http_cache_control always;
		}

		location ~ ^/api/volumes/[0-9]+/dataset\.ome\.zarr/ {
			gzip off;
			proxy_buffering off;
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		location / {
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";

			# off: stream the upload straight through to the app; nginx writes nothing to
			#      disk, and the app spools it into the processing directory itself.
			# on:  nginx first receives the whole upload into
			#      /processing/.nginx_client_body (see client_body_temp_path above) and only
			#      then forwards it, so the app never waits on a slow client.
			# Set with VG_NGINX_REQUEST_BUFFERING in .env (default: off).
			proxy_request_buffering ${VG_NGINX_REQUEST_BUFFERING};
			
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}
	}
}