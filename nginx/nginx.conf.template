# The stock image's nginx.conf (which sets this) is replaced by this template, so without
# it nginx runs a single worker process.
worker_processes auto;

events {
    worker_connections 1024;
}
 
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;
    # Don't let one large sendfile() monopolise a worker while many chunk requests wait.
    sendfile_max_chunk 1m;
    # Chunk loading issues thousands of requests per connection; the default (1000)
    # forces a reconnect + TLS handshake every few seconds of panning.
    keepalive_requests 100000;

    open_file_cache          max=4096 inactive=60s;
    open_file_cache_valid    30s;
    open_file_cache_min_uses 2;
    open_file_cache_errors   on;

    gzip              on;
    gzip_comp_level   4;
    gzip_min_length   1024;
    gzip_vary         on;
    gzip_types        application/json text/css text/javascript application/javascript image/svg+xml;
 
    # TIFF-stack archives can be large — don't cap upload size.
    client_max_body_size 0;

    # Anything nginx has to spool to disk goes into the processing directory (mounted
    # into this container at /processing, see docker-compose.yml), never into the
    # container's writable layer. That covers an upload body when request buffering is
    # on (see proxy_request_buffering below) and large proxied responses. nginx creates
    # these directories itself at startup (as root, then hands them to the worker user,
    # see docker-entrypoint.d/05-worker-user.sh), so the parent (/processing) must be
    # writable. The direct-upload locations further down set their own temp paths.
    client_body_temp_path /processing/.nginx_client_body 1 2;
    proxy_temp_path       /processing/.nginx_proxy 1 2;

    proxy_read_timeout 1200s;
    proxy_send_timeout 1200s;
    client_body_timeout 1200s;

    # Brute-force protection, per client address: the login endpoint and share-link lookups.
    limit_req_zone $binary_remote_addr zone=vg_login:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=vg_share:10m rate=30r/m;
    limit_req_status 429;

    upstream volume_gallery_backend {
        server volume-gallery:8000;
        keepalive 32;
    }
 
    # Plain HTTP just redirects to HTTPS. WebGPU (needed by the volume
    # viewer) refuses to run outside a secure context, so there's no
    # reason to ever serve the app itself over http://.
    #
    # IPv4 only by default — add "listen [::]:80;" / "listen [::]:443 ssl;"
    # below if your Docker host has IPv6 enabled and you need LAN IPv6
    # access; some Docker hosts (including some TrueNAS SCALE setups) don't
    # have it enabled, and nginx fails to start entirely if told to bind an
    # address family the host doesn't support

	# HTTP block
	server {
		listen 80;
		server_name _;
		return 301 https://$host:${VG_HTTPS_PORT}$request_uri;
	}

	# HTTPS block
	server {
		listen 443 ssl;
		http2 on;
		server_name _;

		ssl_certificate     /etc/nginx/certs/fullchain.pem;
		ssl_certificate_key /etc/nginx/certs/privkey.pem;
		ssl_protocols       TLSv1.2 TLSv1.3;
		ssl_ciphers         HIGH:!aNULL:!MD5;
		ssl_prefer_server_ciphers on;
		# Chunk loading opens several connections; resume their TLS sessions instead of
		# running a full handshake each time.
		ssl_session_cache   shared:SSL:10m;
			ssl_session_timeout 1d;

		# Security headers. No location below sets add_header itself, so these apply everywhere
		# (a location that adds its own header would have to repeat them). A full CSP is not set:
		# the Potree and 3DHOP viewers use inline scripts and workers.
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header Referrer-Policy "same-origin" always;
		add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
		add_header Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;

		# Internal location used by serve_sharded_file's X-Accel-Redirect response.
		# Marked `internal;` so direct client requests to /_internal_volumes/... return 404.
		location /_internal_volumes/ {
			internal;
			gzip off;
			alias /data/volumes/;
            # Cache-Control / Content-Type set by the backend are carried over automatically
			# on X-Accel-Redirect; adding them again here duplicated the header.
		}

		# ---- Direct uploads: the file is written to disk once, by nginx ----
		# The browser PUTs each big file as a raw request body (frontend/js/api.js). nginx
		# stores that body in a temp file inside the directory the file is going to be
		# processed in, then calls the app WITHOUT the body, telling it only the temp file's
		# path in X-Upload-File. The app renames the file (backend/app/routers/uploads.py), and
		# later renames it again into the asset's folder: no byte is copied after it
		# arrived. That needs
		#  - the same filesystem: /processing here and in the app container is one mount, and
		#    for meshes (whose original is kept in the data folder) so is /data/.uploads;
		#  - the same user: nginx creates the temp file with mode 0600, so the app can only
		#    read it if the workers run as the app's uid (VG_UID / VG_GID, see the
		#    entrypoint script), or if the app runs as root.
		# `clean`: nginx deletes the file when the request ends, so an upload that is
		# aborted half-way leaves nothing behind (after the app's rename there is nothing
		# left to delete, which nginx quietly accepts).
		# The auth_request check runs before nginx reads the first byte of the body, so
		# nobody who may not create assets can make nginx write to the disk.
		location = /_vg_upload_auth {
			internal;
			proxy_pass http://volume_gallery_backend/api/uploads/auth;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_pass_request_body off;
			proxy_set_header Content-Length "";
			proxy_set_header X-Upload-File "";
		}

		location ~ ^/api/uploads/(volume|pointcloud)$ {
			if ($request_method != PUT) { return 405; }
			auth_request /_vg_upload_auth;

			client_body_temp_path /processing/.uploads;
			client_body_in_file_only clean;
			client_body_buffer_size 1m;
			proxy_pass_request_body off;
			proxy_set_header Content-Length "";
			proxy_set_header X-Upload-File $request_body_file;

			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		# Meshes land in the data folder's own staging directory (mounted rw at
		# /data/.uploads, see docker-compose.yml): the mesh original stays there.
		location = /api/uploads/mesh {
			if ($request_method != PUT) { return 405; }
			auth_request /_vg_upload_auth;

			client_body_temp_path /data/.uploads;
			client_body_in_file_only clean;
			client_body_buffer_size 1m;
			proxy_pass_request_body off;
			proxy_set_header Content-Length "";
			proxy_set_header X-Upload-File $request_body_file;

			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		location ~ ^/api/volumes/[0-9]+/(dataset|slices)/ {
			gzip off;
			proxy_buffering off;
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		# Over the limit the client gets a JSON 429 that the login page can show as an error.
		error_page 429 = @vg_rate_limited;
		location @vg_rate_limited {
			default_type application/json;
			return 429 '{"detail":"Too many attempts. Wait a minute and try again."}';
		}

		location = /api/auth/login {
			limit_req zone=vg_login burst=10 nodelay;
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		location ^~ /s/ {
			limit_req zone=vg_share burst=30 nodelay;
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";
			proxy_set_header Host $host:${VG_HTTPS_PORT};
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}

		location / {
			proxy_pass http://volume_gallery_backend;
			proxy_http_version 1.1;
			proxy_set_header Connection "";

			# off: stream the upload straight through to the app; nginx writes nothing to
			#      disk, and the app spools it into the processing directory itself.
			# on:  nginx first receives the whole upload into
			#      /processing/.nginx_client_body (see client_body_temp_path above) and only
			#      then forwards it, so the app never waits on a slow client.
			# Set with VG_NGINX_REQUEST_BUFFERING in .env (default: off).
			proxy_request_buffering ${VG_NGINX_REQUEST_BUFFERING};

			# Only the upload locations above may tell the app where a file is.
			proxy_set_header X-Upload-File "";

			proxy_set_header Host $host:${VG_HTTPS_PORT};
			
			proxy_set_header X-Real-IP $remote_addr;
			proxy_set_header X-Forwarded-For $remote_addr;
			proxy_set_header X-Forwarded-Proto https;
			proxy_set_header X-Forwarded-Port ${VG_HTTPS_PORT};
		}
	}
}