# Copy to .env and fill in real values before running docker compose.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VG_SECRET_KEY=
VG_HTTPS_PORT=8443

# First-run bootstrap admin account (only created if the user table is empty).
# After first login you can create further admins from the Users page and,
# if you like, blank this out / rotate the password.
VG_ADMIN_USER=admin
VG_ADMIN_PASSWORD=

# Where the ZFS dataset backing /data is mounted on the TrueNAS host.
VG_HOST_DATA_DIR=/mnt/tank/apps/volume-gallery/data

# Optional: token lifetimes in minutes
VG_ACCESS_TOKEN_MINUTES=480
VG_FILE_TOKEN_MINUTES=30
