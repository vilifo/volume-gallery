# Copy to .env and fill in real values before running docker compose.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VG_SECRET_KEY=

# First-run bootstrap admin account (only created if the user table is empty).
# After first login you can create further admins from the Users page and,
# if you like, blank this out / rotate the password.
VG_ADMIN_USER=admin
VG_ADMIN_PASSWORD=

# Where the ZFS dataset backing /data is mounted on the TrueNAS host.
VG_HOST_DATA_DIR=/mnt/tank/apps/volume-gallery/data

# Optional: process uploads in a separate scratch directory instead of inside
# /data. Archive extraction, TIFF -> OME-Zarr conversion and mesh / point-cloud
# conversion (plus the temp files of large uploads) then happen there, and only
# the finished result is moved into /data. Leave VG_PROCESSING_DIR blank to keep
# processing inside /data. To enable it, set it to /processing — the container
# path VG_HOST_PROCESSING_DIR is mounted at. Ideally point the host directory at
# a fast disk that is NOT the data dataset; budget about 2-3x the size of the
# largest upload in free space (see the README's "Processing directory").
VG_PROCESSING_DIR=
VG_HOST_PROCESSING_DIR=./processing

# Optional: run the app container as a non-root user (default 0:0 = root). On
# TrueNAS SCALE that is typically the "apps" user, 568:568. The host directories
# behind VG_HOST_DATA_DIR / VG_HOST_PROCESSING_DIR must be writable by that user.
# VG_UID=568
# VG_GID=568

# nginx (reverse proxy / HTTPS) settings — see nginx/nginx.conf and
# nginx/generate-self-signed-cert.sh, and the README's "Putting it behind
# HTTPS" section.
#
# Host ports nginx is reachable on. Default to something other than 80/443
# since TrueNAS's own web UI commonly already occupies those. Change these
# back to 80/443 if nothing else on the host needs them.
VG_HTTP_PORT=8080
VG_HTTPS_PORT=8443
# Host directory containing fullchain.pem + privkey.pem. Defaults to
# ./nginx/certs (where generate-self-signed-cert.sh writes to) — override
# this instead if your certs already live somewhere else (e.g. a TrueNAS
# certificate dataset) and you'd rather not copy them into this repo.
VG_CERT_DIR=./nginx/certs

# Optional: token lifetimes in minutes
VG_ACCESS_TOKEN_MINUTES=480
VG_FILE_TOKEN_MINUTES=30
