# Copy to .env and fill in real values before running docker compose.

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VG_SECRET_KEY=

# First-run bootstrap admin account (only created if the user table is empty).
# After first login you can create further admins from the Users page and,
# if you like, blank this out / rotate the password.
VG_ADMIN_USER=admin
VG_ADMIN_PASSWORD=

# Where the ZFS dataset backing /data is mounted on the TrueNAS host.
VG_HOST_DATA_DIR=/mnt/tank/apps/volume-gallery/data

# Scratch directory: uploads are written there (by nginx, once), unpacked and converted;
# only the finished result lands in /data. It is mounted at /processing in both the app and
# nginx containers, so leave VG_PROCESSING_DIR blank (= /processing). Ideally point the host
# directory at a fast disk that is NOT the data dataset; budget about 2-3x the size of the
# largest upload in free space (see the README's "Processing directory").
VG_PROCESSING_DIR=
VG_HOST_PROCESSING_DIR=./processing

# Optional: run as a non-root user (default 0:0 = root). On TrueNAS SCALE that is typically
# the "apps" user, 568:568. This one setting makes the app run as that user, makes nginx's
# worker processes run as the same user (required: nginx hands uploads to the app as files
# only that user can read), and has a one-shot init container chown the host directories
# behind VG_HOST_DATA_DIR / VG_HOST_PROCESSING_DIR for you.
# VG_UID=568
# VG_GID=568

# Longest a mesh or point cloud converter (nxsbuild, PotreeConverter) may run on one upload before
# the job is failed, in hours (0 = no limit).
# VG_CONVERTER_TIMEOUT_HOURS=24

# Optional: hours after which an upload that was never turned into a volume / mesh / point
# cloud is deleted from the .uploads folders (default 24).
# VG_UPLOAD_STAGING_MAX_AGE_HOURS=24

# nginx (reverse proxy / HTTPS) settings — see nginx/nginx.conf and
# nginx/generate-self-signed-cert.sh, and the README's "Putting it behind
# HTTPS" section.
#
# Host ports nginx is reachable on. Default to something other than 80/443
# since TrueNAS's own web UI commonly already occupies those. Change these
# back to 80/443 if nothing else on the host needs them.
VG_HTTP_PORT=8080
VG_HTTPS_PORT=8443
# Host directory containing fullchain.pem + privkey.pem. Defaults to
# ./nginx/certs (where generate-self-signed-cert.sh writes to) — override
# this instead if your certs already live somewhere else (e.g. a TrueNAS
# certificate dataset) and you'd rather not copy them into this repo.
VG_CERT_DIR=./nginx/certs

# Optional: token lifetimes in minutes
VG_ACCESS_TOKEN_MINUTES=480
VG_FILE_TOKEN_MINUTES=30

# Optional: offload sharded binary serving to nginx via X-Accel-Redirect
# (enabled automatically in docker-compose.yml; keep false for bare uvicorn).
# VG_SHARD_ACCEL_REDIRECT=true

# Optional: min and max character length for custom/generated share link codes (/s/<code>)
VG_SHARE_CODE_MIN_LENGTH=8
VG_SHARE_CODE_MAX_LENGTH=24
