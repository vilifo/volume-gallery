+.theme-switch[data-pos="0"] { --pos: 0; }
+.theme-switch[data-pos="1"] { --pos: 1; }
+.theme-switch[data-pos="2"] { --pos: 2; }
+.theme-switch::before {            /* sliding thumb */
+  content: "";
+  position: absolute;
+  top: 2px; bottom: 2px; left: 2px;
+  width: calc((100% - 4px) / 3);
+  border-radius: 999px;
