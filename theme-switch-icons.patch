 }
-.theme-switch button + button { border-left: 1px solid var(--line); }
-.theme-switch button:hover { color: var(--text); }
-.theme-switch button[aria-pressed="true"] { background: var(--panel-raised); color: var(--text); font-weight: 600; }
+.theme-switch button:hover { color: var(--text); border: none; }
+.theme-switch button[aria-checked="true"] { color: var(--accent); }
+.theme-switch svg { width: 14px; height: 14px; }
